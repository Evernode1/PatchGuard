# PatchGuard frontend configuration. Copy to .env and fill in.
# Vite exposes only VITE_-prefixed vars to the browser. These are PUBLIC values
# (safe to ship in a client bundle) — never put a private key here.

# Privy App ID (https://dashboard.privy.io -> your app -> App ID).
VITE_PRIVY_APP_ID=

# Deployed PatchGuard contract address on GenLayer Studio.
VITE_CONTRACT_ADDRESS=0x1862909bdff2bC0667eF9B799Af5f0b5A25744F8
