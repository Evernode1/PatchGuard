# PatchGuard — deployment configuration (root). Used by deploy/deploy.mjs and
# integration tests (gltest.config.yaml). Copy to .env and fill in real values.
# NEVER commit .env. NEVER print or log these values.

# Private key of a GenLayer Studio account. Studio ships with pre-funded local
# accounts (see `genlayer accounts` after `genlayer up`), or use your own.
ACCOUNT_PRIVATE_KEY=

# Optional: wallet that receives the protocol fee on premiums (defaults to deployer).
FEE_WALLET=

# Optional: protocol fee on premiums in basis points (default 500 = 5%, max 2000).
FEE_BPS=500

# Set by deploy/deploy.mjs after a successful deployment (the deployed address).
CONTRACT_ADDRESS=0x1862909bdff2bC0667eF9B799Af5f0b5A25744F8
